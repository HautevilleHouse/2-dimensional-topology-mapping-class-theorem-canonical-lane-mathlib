/-! ## Core domain definitions -/

/-- A closed orientable surface of genus g. -/
inductive Surface where
  | sphere
  | torus
  | genus (g : Nat)
deriving Repr, DecidableEq

/-- A presentation of the mapping class group of a surface. -/
structure MappingClassGroup where
  surface : Surface
  standardGenerators : List String
  definingRelations : List String
deriving Repr, DecidableEq

/-- Euler characteristic of a surface. -/
def Surface.eulerCharacteristic : Surface → Int
  | .sphere => 2
  | .torus => 0
  | .genus g => 2 - 2 * (g : Int)

/-- The admissible-class bridge: connects a surface to its key mapping class group invariants. -/
structure AdmissibleClassBridge where
  surface : Surface
  eulerCharacteristic : Int
  mappingClassGroupRank : Nat
  generatedByDehnTwists : Prop
deriving Repr

/-- An example bridge for the torus. -/
def torusBridge : AdmissibleClassBridge :=
  { surface := .torus,
    eulerCharacteristic := 0,
    mappingClassGroupRank := 2,
    generatedByDehnTwists := True }

